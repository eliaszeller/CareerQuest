# Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./careerquest.db
SESSION_SECRET=replace-with-a-long-random-value

# Local model services
TEXT_MODEL_URL=http://127.0.0.1:9001
TEXT_MODEL_NAME=Qwen3.6-35B-A3B
IMAGE_MODEL_URL=http://127.0.0.1:9006
IMAGE_MODEL_NAME=FLUX.2-klein-4B
TTS_MODEL_URL=http://127.0.0.1:9008
TTS_MODEL_NAME=Chatterbox-Multilingual-V3
TTS_ENABLED=false

# Public browser key used only to request organization logos from Logo.dev.
# Create one at https://www.logo.dev and restart the Vite server after setting it.
VITE_LOGO_DEV_TOKEN=

# Upload policy
MAX_UPLOAD_BYTES=5242880
UPLOAD_TEMP_TTL_SECONDS=900
